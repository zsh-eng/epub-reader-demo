{
  "name": "@zsh-eng/local-sync",
  "version": "0.0.0",
  "private": true,
  "description": "Storage-agnostic primitives for local-first applications",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./blob": {
      "types": "./dist/blob/index.d.ts",
      "import": "./dist/blob/index.js"
    },
    "./adapters/sqlite": {
      "types": "./dist/adapters/sqlite/index.d.ts",
      "import": "./dist/adapters/sqlite/index.js"
    },
    "./adapters/sqlite/testing": {
      "types": "./dist/adapters/sqlite/testing.d.ts",
      "import": "./dist/adapters/sqlite/testing.js"
    },
    "./adapters/sqlite-wasm": {
      "types": "./dist/adapters/sqlite-wasm/index.d.ts",
      "import": "./dist/adapters/sqlite-wasm/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun run test:unit && bun run test:sqlite && bun run test:sqlite-wasm",
    "test:sqlite": "bun test ./test/sqlite-driver-conformance.bun.ts ./test/sqlite-schema.bun.ts",
    "test:sqlite-wasm": "bun run build && playwright test --config test/sqlite-wasm/playwright.config.ts",
    "test:unit": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.5"
  }
}
