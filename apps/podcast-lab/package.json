{
  "name": "@workbench/podcast-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build && bun server.ts",
    "build": "tsc --noEmit && bun build web/player.ts --outdir dist --minify",
    "test": "bun test tests/server.test.ts && python3 -m unittest discover -s tests -v",
    "test:e2e": "python3 pipeline/library.py .local --catalog tests/fixtures/benchmark-feeds.json --output .local/benchmark/library-test.json && playwright test",
    "lint": "oxlint web server.ts tests/*.ts",
    "feeds:refresh": ".venv/bin/python pipeline/feeds.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/bun": "1.3.9",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@tanstack/query-core": "5.100.1"
  }
}
