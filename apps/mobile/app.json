{
  "expo": {
    "name": "Reader",
    "icon": "../../public/pwa-512x512.png",
    "slug": "reader-mobile",
    "scheme": "reader",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios"],
    "ios": {
      "bundleIdentifier": "app.zsheng.reader.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "EPUB book",
            "LSItemContentTypes": ["org.idpf.epub-container"],
            "LSHandlerRank": "Alternate"
          }
        ]
      }
    },
    "plugins": ["expo-router", "expo-document-picker", "expo-font"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
